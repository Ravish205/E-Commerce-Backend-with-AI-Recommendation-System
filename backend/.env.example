# Application
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_SECRET_KEY=change-this-to-a-secure-random-jwt-key-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7
PORT=5000

# Database
# Production PostgreSQL example: postgresql://postgres:postgres@localhost:5432/ecommerce_db
DATABASE_URL=sqlite:///ecommerce.db

# Redis Caching (Optional fallback to in-memory)
REDIS_URL=redis://localhost:6379/0

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_placeholder_webhook_secret

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
